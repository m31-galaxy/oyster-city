# Copy to .env.local for development; set both in the production environment.

# TfL Unified API key — register free at https://api-portal.tfl.gov.uk.
# Auth is the app_key query param ONLY (the old app_id is deprecated and NOT
# required). Optional in development: anonymous access works but is limited
# to ~12 requests/min; a key raises that to 500/min. Read server-side only
# by the API proxy — never reaches the browser.
TFL_APP_KEY=

# tldraw license key, bound to the deployment origin. REQUIRED in production:
# without it the editor blanks itself 5 seconds after load
# (unlicensed-production state). Inlined at BUILD time — rebuild after setting.
NEXT_PUBLIC_TLDRAW_LICENSE_KEY=

# National Rail live trains (Thameslink). Darwin LDBWS access token —
# register free via the Rail Data Marketplace (raildata.org.uk) / National
# Rail developer portal. Without it, NR lines draw with no trains.
RAIL_LDB_TOKEN=
# Override the LDBWS endpoint (defaults to the official OpenLDBWS URL).
RAIL_LDB_URL=
# Dev only: RAIL_FIXTURE=1 serves synthetic moving Thameslink services so the
# rendering pipeline can be exercised without Darwin credentials.
RAIL_FIXTURE=
